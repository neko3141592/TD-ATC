{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Train Track JSON",
  "type": "object",
  "required": ["version", "trackName", "geometries", "trackGroups"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "trackName": { "type": "string" },
    "geometries": {
      "type": "array",
      "items": { "$ref": "#/$defs/geometry" }
    },
    "trackGroups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trackGroup" }
    }
  },
  "$defs": {
    "geometry": {
      "type": "object",
      "required": ["name", "origin", "yawDeg", "segments"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/vector3" },
        "yawDeg": { "type": "number" },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/horizontal" }
        },
        "vertical": {
          "type": "array",
          "items": { "$ref": "#/$defs/vertical" }
        },
        "cant": {
          "type": "array",
          "items": { "$ref": "#/$defs/cant" }
        }
      }
    },
    "trackGroup": {
      "type": "object",
      "required": ["id", "name", "tracks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/track" }
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/$defs/connection" }
        },
        "signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/signal" }
        }
      }
    },
    "track": {
      "type": "object",
      "required": ["name", "baseCenterLineId", "offset", "speedLimitKmH"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "baseCenterLineId": { "type": "string", "minLength": 1 },
        "offset": {
          "type": "array",
          "items": { "$ref": "#/$defs/offsetSegment" }
        },
        "boundaryDistanceM": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "blockIntervalM": { "type": "number", "minimum": 0 },
        "speedLimitKmH": { "type": "number" }
      }
    },
    "horizontal": {
      "type": "object",
      "required": ["type", "lengthM"],
      "properties": {
        "type": { "enum": ["straight", "curve", "transitionIn", "transitionOut"] },
        "lengthM": { "type": "number", "exclusiveMinimum": 0 },
        "radiusM": { "type": "number" }
      }
    },
    "vertical": {
      "type": "object",
      "required": ["startM", "lengthM", "startPermille", "endPermille"],
      "properties": {
        "startM": { "type": "number", "minimum": 0 },
        "lengthM": { "type": "number", "minimum": 0 },
        "startPermille": { "type": "number" },
        "endPermille": { "type": "number" }
      }
    },
    "cant": {
      "type": "object",
      "required": ["startM", "lengthM", "startMm", "endMm"],
      "properties": {
        "startM": { "type": "number", "minimum": 0 },
        "lengthM": { "type": "number", "minimum": 0 },
        "startMm": { "type": "number" },
        "endMm": { "type": "number" }
      }
    },
    "offsetSegment": {
      "type": "object",
      "required": ["startBaseM", "lengthM", "type"],
      "properties": {
        "type": { "enum": ["constant", "linear", "cubic"] },
        "startBaseM": { "type": "number", "minimum": 0 },
        "lengthM": { "type": "number", "exclusiveMinimum": 0 },
        "offsetM": { "type": "number" },
        "startOffsetM": { "type": "number" },
        "endOffsetM": { "type": "number" }
      }
    },
    "connection": {
      "type": "object",
      "required": ["name", "points"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["trackName", "end"],
            "properties": {
              "trackName": { "type": "string", "minLength": 1 },
              "end": { "enum": ["start", "end"] }
            }
          }
        }
      }
    },
    "signal": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "trackName": { "type": "string" },
        "distanceM": { "type": "number", "minimum": 0 }
      }
    },
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    }
  }
}
